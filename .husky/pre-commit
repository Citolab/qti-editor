#!/usr/bin/env sh
# Strip yalc deps from staged package.json files before they enter a commit.
# After the commit, run `pnpm yalc:add` to restore yalc dev mode.

# Not in CI. Every check below gates a HUMAN commit — a developer about to push code — and none of
# them has a subject when the committer is a robot.
#
# This is not hypothetical tidiness. It broke the release: multi-semantic-release commits the
# version bump itself, that commit fired this hook, and the hook ran the browser tests, which died
# with "Executable doesn't exist at .../chrome-headless-shell" because the release job installs no
# Playwright browsers and has no reason to. The release then failed having published nothing, so
# main sat several merges ahead of npm with no sign of why.
#
# CI runs the real gates over the whole repo (.github/workflows/ci.yml) and the release only runs
# at all once that has passed, so nothing is skipped here that was not already checked more
# thoroughly there.
if [ -n "$CI" ]; then
  exit 0
fi

# There is deliberately no check for .qti-components-local-link-state.json here.
#
# Source-link mode cannot reach a commit. Its state file is gitignored, and .storybook/main.ts is
# its only consumer — it turns into Vite aliases for the Storybook dev server and nothing else.
# node_modules/@qti-components holds published packages either way, so eslint, tsc, vitest and every
# build resolve identically whether the mode is on or off.
#
# Blocking the commit therefore protected nothing, while costing a `pnpm unlink` (full install and
# cache clear) and a relink around every commit. The two checks below are different: `link:` and
# `file:.yalc/` deps are written INTO tracked package.json files, so those can genuinely go live.

linked_qti_in_index=false
staged_pkg_jsons=$(git diff --cached --name-only --diff-filter=ACM -- '*package.json')
for f in $staged_pkg_jsons; do
  if git show ":$f" 2>/dev/null | grep -Eq '"@qti-components/.+": "link:|"@citolab/qti-components": "link:'; then
    linked_qti_in_index=true
    break
  fi
done

if [ "$linked_qti_in_index" = "true" ]; then
  echo ""
  echo "❌ pre-commit: staged package.json files still contain qti-components link: deps."
  echo "   Run: pnpm unlink"
  echo "   Then re-stage and commit."
  echo ""
  exit 1
fi

yalc_in_index=false
for f in $staged_pkg_jsons; do
  if git show ":$f" 2>/dev/null | grep -q '"file:\.yalc/'; then
    yalc_in_index=true
    break
  fi
done

if [ "$yalc_in_index" = "true" ]; then
  echo ""
  echo "🧹 pre-commit: yalc file: deps detected in staged package.json files."
  echo "   Running 'yalc retreat --all' and re-staging clean versions..."
  yalc retreat --all || exit 1
  modified=$(git diff --name-only -- '*package.json')
  if [ -n "$modified" ]; then
    echo "$modified" | xargs git add
  fi
  echo "✅ yalc removed from index. Commit will proceed with clean package.json."
  echo "   To restore yalc dev mode after commit: pnpm yalc:add"
  echo ""
fi

# Lint and test the STAGED changes — eslint --fix on the staged source files, and one
# `vitest run --changed` for the commit as a whole. See .lintstagedrc.mjs: the comment there
# explains why the test call has to stay inside lint-staged (that is what makes "changed" mean
# "staged"), and why it is --changed rather than a glob-seeded `vitest related`.
#
# This replaces a whole-repo `eslint .`. CI still runs `pnpm lint:check` over everything
# (.github/workflows/ci.yml), which is where a repo-wide check belongs; a commit gate should look at
# the commit.
#
# --hide-unstaged is load-bearing: by default lint-staged hides only PARTIALLY staged files, so a
# fully unstaged edit stays on disk and `vitest --changed` picks it up — letting an unstaged fix mask
# a staged bug. With the flag, "changed" and "staged" are the same set. Anything hidden is
# recoverable from `git stash list`.
echo "🔍 pre-commit: linting and testing staged changes…"
if ! npx lint-staged --allow-empty --hide-unstaged; then
  echo ""
  echo "❌ Pre-commit checks failed. Fix the errors above, then re-commit."
  echo "   To bypass in an emergency: git commit --no-verify"
  exit 1
fi
