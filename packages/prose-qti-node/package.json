{
  "name": "@citolab/prose-qti-node",
  "version": "0.0.1",
  "description": "QTI 3.0 <-> ProseMirror conversion for plain Node. No browser, no web components.",
  "license": "GPL-3.0-only",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Citolab/qti-editor",
    "directory": "packages/prose-qti-node"
  },
  "scripts": {
    "build": "node scripts/bundle-node.mjs && node scripts/bundle-types.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "linkedom": "^0.18.13",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-tables": "^1.8.5"
  },
  "peerDependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-model": "^1.25.8",
    "prosemirror-state": "^1.4.4"
  },
  "devDependencies": {
    "@citolab/prose-qti": "workspace:*",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.27.7",
    "vitest": "^4.1.10"
  }
}
